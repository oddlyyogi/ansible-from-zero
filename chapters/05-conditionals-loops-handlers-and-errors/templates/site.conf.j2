# {{ ansible_managed }}
server {
    listen {{ http_port }} default_server;
    server_name {{ inventory_hostname }};
    root /var/www/html;
    index index.html;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    {# one location is enough for a static page #}
    location / {
        try_files $uri $uri/ =404;
    }
}